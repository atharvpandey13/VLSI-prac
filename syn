
module sync_counter (
    input clk,
    input rst,
    input up_down,
    output reg [2:0] count
);

always @(posedge clk)
begin
    if (rst)
        count <= 3'b000;

    else if (up_down)
        count <= count + 1'b1;

    else
        count <= count - 1'b1;
end

endmodule








`timescale 1ns/1ps

module sync_counter_tb;

reg clk;
reg rst;
reg up_down;

wire [2:0] count;

sync_counter uut (
    .clk(clk),
    .rst(rst),
    .up_down(up_down),
    .count(count)
);

initial begin
    clk = 0;
    forever #5 clk = ~clk;
end

initial begin
  
    rst = 1;
    up_down = 1;
    #10;
    rst = 0;

    up_down = 1;
    #80;

    rst = 1;
    #10;
    rst = 0;

    up_down = 1;
    #70;

    up_down = 0;
    #80;

    rst = 1;
    #10;
    rst = 0;

    #20;
    $finish;

end

endmodule
